DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_JWT_REFRESH_SECRET=use-a-different-random-secret-at-least-32-characters
ADMIN_JWT_ACCESS_EXPIRES_IN=15m
ADMIN_JWT_REFRESH_EXPIRES_IN=12h
PORT=3000
CORS_ORIGINS=*

# Optional Firebase Admin credentials; use escaped \n in the private key value.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Required to authorize the scheduled mission-reminder endpoint.
CRON_SECRET=replace-with-a-long-random-secret
MISSION_REMINDER_MINUTES=60
MISSION_REMINDER_WINDOW_MINUTES=15
NEARBY_LOCATION_MAX_AGE_MINUTES=15
NEARBY_LOCATION_MAX_ACCURACY_METERS=100
MISSION_NEARBY_NOTIFICATION_RADIUS_METERS=10000

# Bootstrap the first separate Admin account using: npm run admin:bootstrap

# Location history is retained for 30 days, then removed by the protected cron endpoint.
